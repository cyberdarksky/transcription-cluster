# ─────────────────────────────────────────────────────────────────────────────
# Transkripsiyon Kümesi Koordinatör — Ortam Değişkenleri
# Bu dosyayı .env olarak kopyalayın ve değerleri düzenleyin.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL bağlantı URL'si (asyncpg sürücüsü)
DATABASE_URL=postgresql+asyncpg://localhost/transcription_cluster

# Sunucu yapılandırması
COORDINATOR_HOST=0.0.0.0
COORDINATOR_PORT=8080

# Dosya depolama (mutlak yollar)
INPUT_BASE_DIR=/opt/transcription-data/input
OUTPUT_BASE_DIR=/opt/transcription-data/output
STATIC_DIR=/opt/transcription-cluster/coordinator/static

# Günlük yapılandırması
LOG_LEVEL=INFO
JSON_LOGS=true

# İşçi izleme
WORKER_HEARTBEAT_TIMEOUT_SECONDS=90
RECOVERY_GRACE_SECONDS=30

# Bakım
WORKER_METRICS_RETENTION_DAYS=7
JOB_EVENTS_RETENTION_DAYS=90

# Kiralama sistemi (saniye)
JOB_LEASE_DURATION_SECONDS=300
LEASE_RECOVERY_INTERVAL_SECONDS=30
RETRY_SCHEDULER_INTERVAL_SECONDS=30

# Whisper modeli — işçilerin kullandığı yerel model yolu
WHISPER_MODEL_PATH=/opt/transcription-models/whisper-medium-mlx

# Koordinatör meta verisi
COORDINATOR_VERSION=1.0.0
SERVICE_NAME=TranscriptionCluster

# Geliştirme seçenekleri (üretimde false)
DB_ECHO=false
RELOAD=false
