<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.transcription.pgwatcher</string>

    <key>ProgramArguments</key>
    <array>
        <string>INSTALL_DIR/coordinator/scripts/ensure-postgres.sh</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>POSTGRES_BIN:/usr/local/bin:/usr/bin:/bin</string>
        <key>POSTGRES_BIN</key>
        <string>POSTGRES_BIN</string>
    </dict>

    <key>StartInterval</key>
    <integer>60</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>LOG_DIR/pgwatcher.log</string>
    <key>StandardErrorPath</key>
    <string>LOG_DIR/pgwatcher-error.log</string>
</dict>
</plist>
