# ─────────────────────────────────────────────────────────────────────────────
# Transkripsiyon Kümesi İşçi — Ortam Değişkenleri
# Bu dosyayı .env olarak kopyalayın ve değerleri düzenleyin.
# ─────────────────────────────────────────────────────────────────────────────

# Koordinatör bağlantısı
# Eğer ayarlanmazsa, mDNS otomatik keşfi kullanılır.
# COORDINATOR_HOST=192.168.1.101
COORDINATOR_PORT=8080

# Whisper modeli — YEREL MUTLAK YOL (HuggingFace repo adı değil)
MODEL_PATH=/opt/transcription-models/whisper-medium-mlx
WHISPER_LANGUAGE=tr
WHISPER_WORD_TIMESTAMPS=true

# Geçici dosya dizini
TEMP_DIR=/tmp/transcription-jobs

# Günlük ayarları
LOG_LEVEL=INFO
JSON_LOGS=true

# Zamanlama (saniye)
HEARTBEAT_INTERVAL_SECONDS=30
JOB_POLL_INTERVAL_SECONDS=5
RECONNECT_BASE_DELAY_SECONDS=5
RECONNECT_MAX_DELAY_SECONDS=120
